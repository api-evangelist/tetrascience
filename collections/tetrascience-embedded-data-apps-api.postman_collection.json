          "name": "Install, update, or uninstall Data Apps",
          "request": {
            "name": "Install, update, or uninstall Data Apps",
            "description": {
              "content": "Perform one or more install, update, or uninstall operations on embedded Data Apps. Submit an array of operations to manage which Data Apps are enabled in your organization. This endpoint supports automated governance workflows from CI/CD pipelines, GitHub Actions, or ServiceNow.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "dataapps",
                "apps",
                "manage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
