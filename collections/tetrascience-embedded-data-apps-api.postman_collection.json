          "request": {
            "name": "List available Data Apps for installation",
            "description": {
              "content": "Retrieves the catalog of Data Apps available for installation in your organization, including their current installation status. Use this as the discovery endpoint for automated governance workflows — browse available apps and check requirements before installing.",
