              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ]
          },
          "docs": "Get users with the role"
        },
        {
          "info": {
            "name": "Add / remove users to role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tetrascience.com/v1/roles/:roleId/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add / remove users to role"
        },
        {
          "info": {
            "name": "List all roles in an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
