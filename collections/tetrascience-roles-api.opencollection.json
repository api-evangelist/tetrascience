            ]
          },
          "docs": "Get role by ID"
        },
        {
          "info": {
            "name": "Update role by ID",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tetrascience.com/v1/roles/:roleId",
