        {
          "info": {
            "name": "Create a new role in an organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tetrascience.com/v1/roles",
            "body": {
              "type": "json",
              "data": "{}"
            }
